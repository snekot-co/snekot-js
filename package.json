{
  "name": "@snekot/sdk",
  "version": "0.2.0",
  "description": "Post product events, identify users and set insights with Snekot. For Node, Deno, Bun and edge runtimes, with Effect, React and Vue entry points.",
  "license": "MIT",
  "homepage": "https://snekot.co/docs/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snekot-co/snekot-js.git"
  },
  "bugs": "https://github.com/snekot-co/snekot-js/issues",
  "keywords": [
    "snekot",
    "events",
    "analytics",
    "event-tracking",
    "notifications",
    "effect",
    "react",
    "vue"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "require": {
        "types": "./dist/cjs/effect.d.ts",
        "default": "./dist/cjs/effect.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/cjs/vue.d.ts",
        "default": "./dist/cjs/vue.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }))\"",
    "conformance": "tsx test/conformance.test.ts && tsx test/effect.test.ts",
    "smoke": "tsx test/smoke.ts",
    "test": "pnpm check && pnpm conformance",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "peerDependencies": {
    "effect": "^3.19.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "effect": "^3.19.0",
    "react": "19.2.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
